// Vercel-Funktion: leitet Anfragen der App an die Anthropic-API weiter.
// Der Schluessel liegt nur hier als Umgebungsvariable, nie im Browser.
module.exports = async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Nur POST erlaubt' });

  const pass = process.env.APP_PASSWORD;
  if (!pass || req.headers['x-app-password'] !== pass) {
    return res.status(401).json({ error: 'Passwort falsch oder APP_PASSWORD nicht gesetzt' });
  }
  const key = process.env.ANTHROPIC_API_KEY;
  if (!key) return res.status(500).json({ error: 'ANTHROPIC_API_KEY ist nicht gesetzt' });

  const { messages, tier, web } = req.body || {};
  if (!Array.isArray(messages) || !messages.length) {
    return res.status(400).json({ error: 'messages fehlt' });
  }

  const model = tier === 'complex'
    ? (process.env.MODEL_COMPLEX || 'claude-opus-5-5')
    : (process.env.MODEL_DEFAULT || 'claude-sonnet-5-5');

  const body = { model, max_tokens: 4000, messages };
  if (web) body.tools = [{ type: 'web_search_20250305', name: 'web_search', max_uses: 4 }];

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-api-key': key,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify(body)
    });
    const data = await r.json();
    if (!r.ok) {
      return res.status(r.status).json({ error: (data.error && data.error.message) || 'API-Fehler' });
    }
    const texts = (data.content || []).filter(b => b.type === 'text' && b.text).map(b => b.text);
    return res.status(200).json({ text: texts.length ? texts[texts.length - 1] : '' });
  } catch (e) {
    return res.status(502).json({ error: 'Verbindung zur API fehlgeschlagen: ' + (e.message || e) });
  }
};
